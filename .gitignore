__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/
dist/
build/

# Streamlit
.streamlit/
.streamlit/cache/
.streamlit/secrets.toml

# Environments
.env
.venv/
venv/

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Data generada (PDFs, textos, vectores, base de datos)
data/raw/
data/processed/
data/knowledge_base/
data/reports/
logs/

# Mantener estructura de directorios
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/knowledge_base/.gitkeep
!data/reports/.gitkeep
!logs/.gitkeep

# Excepción: se versiona una MUESTRA del catálogo (actas 2024-25 + resoluciones +
# semillas INIDEP/FAO/SIPA) para que el despliegue muestre datos reales sin ejecutar
# el pipeline. Refrescar con: make demo-corpus && git add -f data/processed/catalog.db
!data/processed/catalog.db

# Coverage
.coverage
coverage.xml
htmlcov/

# Jupyter checkpoints
.ipynb_checkpoints/
# Permitir el config de Streamlit (NO los secrets)
!.streamlit/
!.streamlit/config.toml
.streamlit/secrets.toml

