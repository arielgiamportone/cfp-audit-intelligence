# ── Proveedor de LLM para la auditoría IA ────────────────────────
# "anthropic" (por defecto) o "openai" (cualquier API compatible con OpenAI:
#  OpenAI, Groq, Google Gemini, OpenRouter, Together...).
LLM_PROVIDER=anthropic

# ── Opción A: Anthropic / Claude (si LLM_PROVIDER=anthropic) ─────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_AUDIT_MODEL=claude-opus-4-7

# ── Opción B: proveedor OpenAI-compatible (si LLM_PROVIDER=openai) ─
# Rellena estos y pon LLM_PROVIDER=openai. Ejemplos de tier gratuito:
#   Groq:   OPENAI_BASE_URL=https://api.groq.com/openai/v1        LLM_MODEL=llama-3.3-70b-versatile
#   Gemini: OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-2.0-flash
#   OpenAI: OPENAI_BASE_URL=(vacío)                               LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=
# LLM_AUDIT_MODEL=            # opcional: modelo para análisis de alta complejidad

# ── Paths ────────────────────────────────────────────────────────
DATA_DIR=./data
RAW_PDF_DIR=./data/raw
PROCESSED_DIR=./data/processed
KB_DIR=./data/knowledge_base
REPORTS_DIR=./data/reports

# ── CFP Web ──────────────────────────────────────────────────────
CFP_BASE_URL=https://cfp.gob.ar
CFP_ACTAS_URL=https://cfp.gob.ar/actas-cfp
CFP_SSL_VERIFY=false          # El sitio tiene certificado expirado

# ── Scraping ─────────────────────────────────────────────────────
SCRAPING_DELAY_SECONDS=1.5    # Delay entre requests (uso responsable)
SCRAPING_MAX_RETRIES=3
SCRAPING_TIMEOUT=30

# ── Procesamiento ────────────────────────────────────────────────
OCR_LANGUAGE=spa              # Español para Tesseract
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
BATCH_SIZE_EMBEDDINGS=32

# ── Base de datos ─────────────────────────────────────────────────
DB_PATH=./data/processed/catalog.db

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=./logs
